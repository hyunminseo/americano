{
  "name": "americano",
  "version": "1.0.0",
  "description": "Windows screen automation manager",
  "main": "electron/main.js",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "test": "node --test",
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win portable --x64",
    "build:license-compare": "node scripts/build-license-comparison.cjs",
    "license:init": "node scripts/license-issuer.cjs init"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "screenshot-desktop": "^1.15.0",
    "sharp": "^0.34.3"
  },
  "build": {
    "appId": "com.americano.automation",
    "productName": "Americano",
    "asar": true,
    "files": [
      "electron/**/*",
      "src/macros.js",
      "src/store.js",
      "src/runner.js",
      "src/license.js",
      "src/capture.js",
      "src/matcher.js",
      "src/windows.js",
      "src/input-adapter.js",
      "src/uo-script/**/*"
    ],
    "extraResources": [{ "from": "licensing/public-key.pem", "to": "licensing/public-key.pem" }],
    "win": {
      "icon": "electron/assets/coffee.ico",
      "signExecutable": false,
      "target": "portable"
    },
    "portable": {
      "artifactName": "Americano-Portable.exe"
    }
  }
}

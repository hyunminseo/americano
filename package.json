{
  "name": "americano",
  "version": "1.0.0",
  "description": "Cross-platform visual workflow automation",
  "main": "electron/main.js",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "test": "node --test",
    "start": "electron .",
    "dev": "electron .",
    "build:icon": "node scripts/build-icon.cjs",
    "build": "electron-builder",
    "build:license-compare": "npm run build:icon && node scripts/build-license-comparison.cjs",
    "license:init": "node scripts/license-issuer.cjs init",
    "test:overlay-ui": "electron scripts/overlay-ui-smoke.cjs",
    "test:keyboard-ui": "electron scripts/keyboard-ui-smoke.cjs",
    "test:image-scenario": "electron scripts/image-scenario-smoke.cjs",
    "test:image-mabinogi": "electron scripts/image-scenario-mabinogi.cjs",
    "build:win": "npm run build:icon && electron-builder --win portable --x64",
    "build:mac": "electron-builder --mac dmg --arm64 --x64"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "jsdom": "^29.1.1"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "koffi": "^3.2.1",
    "screenshot-desktop": "^1.15.0",
    "sharp": "^0.34.3"
  },
  "build": {
    "appId": "com.americano.automation",
    "productName": "Americano",
    "asar": true,
    "files": [
      "electron/**/*",
      "src/**/*"
    ],
    "asarUnpack": [
      "node_modules/screenshot-desktop/lib/win32/**/*",
      "node_modules/koffi/**/*",
      "node_modules/@koromix/**/*"
    ],
    "extraResources": [
      {
        "from": "licensing/public-key.pem",
        "to": "licensing/public-key.pem"
      }
    ],
    "win": {
      "icon": "electron/assets/coffee.ico",
      "signExecutable": false,
      "target": "portable"
    },
    "portable": {
      "artifactName": "Americano-Portable.exe"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "워크플로우에서 대상 화면의 이미지를 인식합니다.",
        "NSAppleEventsUsageDescription": "사용자가 선택한 대상 창을 제어합니다."
      }
    }
  }
}

{
  "name": "americano",
  "version": "1.0.0",
  "description": "Windows screen automation manager",
  "main": "electron/main.js",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "test": "node --test",
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "screenshot-desktop": "^1.15.0",
    "sharp": "^0.34.3"
  },
  "build": {
    "appId": "com.americano.automation",
    "productName": "Americano",
    "asar": false,
    "files": [
      "electron/**/*",
      "src/**/*",
      "policy/center_patterns/**/*",
      "targets/**/*",
      "config.example.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
